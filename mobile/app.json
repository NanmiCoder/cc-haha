{
  "expo": {
    "name": "cc-haha",
    "slug": "cc-haha",
    "owner": "relakkesyangs-team",
    "extra": {
      "eas": {
        "projectId": "4e75f835-1b64-463c-a196-cc181b4c83ec"
      }
    },
    "version": "0.1.4",
    "orientation": "portrait",
    "scheme": "cchaha",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": "./assets/icon-ios.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.yunce.cchaha.mobile",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to a computer running cc-haha on the same local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.cchaha.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E8E7E3"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the connection QR code from the cc-haha desktop app.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**"
          }
        }
      ],
      "./plugins/withWebRtcDataChannels",
      "expo-font",
      "./plugins/withPinnedWebSockets",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.yunce.cchaha.mobile.widgets",
          "groupIdentifier": "group.com.yunce.cchaha.mobile",
          "enablePushNotifications": true,
          "frequentUpdates": false,
          "widgets": []
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "cc-haha",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose images and screenshots to send as task materials to your connected computer.",
          "cameraPermission": "Take photos to send as task materials to your connected computer.",
          "microphonePermission": "Records only after you tap voice input; audio is sent to your connected computer for transcription."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Records only after you tap voice input; audio is sent to your connected computer for transcription.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "androidForegroundService": false,
          "androidFSTypes": [],
          "disableFFmpeg": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

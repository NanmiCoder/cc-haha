# EAS uploads the repository root; retain shared mobile imports.
.env
.env.*
!.env.example
node_modules
openspec
.DS_Store

# Computer Use runtime (auto-generated)
.runtime/
extracted-natives/

# Adapter attachment cache (created at runtime by AttachmentStore when
# running adapter tests or the feishu/telegram adapters locally)
.lark-attachments/
.tg-attachments/

# Playwright MCP snapshots & logs
.playwright-mcp/

# OMX state/logs
.omx/

# E2E screenshots
e2e-*.png

# Local/generated artifacts
artifacts/

# Desktop build output
desktop/dist/
desktop/electron-dist/
desktop/build-artifacts/
desktop/src-tauri/binaries/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/package-lock.json

# Desktop brand asset candidates (keep only selected ones in public/)
desktop/brand-assets/

# Claude local config & auto-generated
.claude/

# Superpowers plans & specs (local only)
docs/superpowers/
.superpowers/

# Temp server/web logs
.tmp-*.log

# Debug / temp screenshots (root dir only)
/*.png
bug_attachments/

# Private keys & credentials
*.pem
*.key
*.p12
credentials*.json

# TS build cache
*.tsbuildinfo

# Temp markdown snapshots
sidebar-snapshot.md

runtime/__pycache__

# IDE
.idea

# Codex logs
.codex-logs/

# Local AI assistant artifacts (graph, notes)
CLAUDE.md
.mavis/
.opencode/
graphify-out/

.learnings/

# Computer Use native helper build output (SwiftPM)
native/cu-helper/.build/

# EAS receives source metadata separately; omit Git objects from the archive.
/.git

# Mobile cloud builds do not need other product surfaces or documentation.
/.github/
/adapters/
/desktop/
/docs/
/native/
/site/
/release-notes/
# Generated native projects must be recreated from Expo config plugins.
/mobile/ios/
/mobile/android/
/mobile/.expo/
/mobile/dist/
/mobile/web-build/
# Signing material is supplied by EAS, never by the source archive.
*.p8
*.jks
*.keystore
*.mobileprovision
google-services.json
*service-account*.json

+})
+
+describe('terminal shell/cwd pure helpers', () => {
+  test('defaultShell honours SHELL then falls back to zsh/bash on non-win32', () => {
+    expect(defaultShell('linux', { SHELL: '/bin/fish' })).toBe('/bin/fish')

; Generated by desktop/scripts/generate-install-process-helper-nsh.ts from
; check-install-processes.ps1. Do not edit by hand.
!macro CcHahaWriteInstallProcessHelper _PATH _WRITE_FAILED
  Push $0
  StrCpy ${_WRITE_FAILED} "0"
  ClearErrors
  FileOpen $0 "${_PATH}" w
  ${If} ${Errors}
    StrCpy ${_WRITE_FAILED} "1"
  ${Else}
    FileWrite $0 "[CmdletBinding()]$\n"
    FileWrite $0 "param($\n"
    FileWrite $0 "  [Parameter(Mandatory = $$true)][string]$$InstallDir,$\n"
    FileWrite $0 "  [Parameter(Mandatory = $$true)][string]$$ProcessName,$\n"
    FileWrite $0 "  [ValidateSet('Find', 'Kill', 'KillForce')][string]$$Action = 'Find',$\n"
    FileWrite $0 "  [int]$$InstallerPid = 0,$\n"
    FileWrite $0 "  [int]$$InstallerParentPid = 0$\n"
    FileWrite $0 ")$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "Set-StrictMode -Version Latest$\n"
    FileWrite $0 "$$ErrorActionPreference = 'Stop'$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "function Test-PathInsideInstallDirectory {$\n"
    FileWrite $0 "  param($\n"
    FileWrite $0 "    [Parameter(Mandatory = $$true)][string]$$Root,$\n"
    FileWrite $0 "    [Parameter(Mandatory = $$true)][string]$$Candidate$\n"
    FileWrite $0 "  )$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "  $$resolvedRoot = [IO.Path]::GetFullPath($$Root).TrimEnd('\', '/')$\n"
    FileWrite $0 "  $$resolvedCandidate = [IO.Path]::GetFullPath($$Candidate)$\n"
    FileWrite $0 "  $$rootWithSeparator = $$resolvedRoot + [IO.Path]::DirectorySeparatorChar$\n"
    FileWrite $0 "  return $$resolvedCandidate.StartsWith($\n"
    FileWrite $0 "    $$rootWithSeparator,$\n"
    FileWrite $0 "    [StringComparison]::OrdinalIgnoreCase)$\n"
    FileWrite $0 "}$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "try {$\n"
    FileWrite $0 "  $$matches = New-Object 'System.Collections.Generic.List[object]'$\n"
    FileWrite $0 "  $$unknownPathMatches = New-Object 'System.Collections.Generic.List[object]'$\n"
    FileWrite $0 "  foreach ($$process in @(Get-CimInstance Win32_Process -ErrorAction Stop)) {$\n"
    FileWrite $0 "    if ($$process.ProcessId -eq $$InstallerPid) {$\n"
    FileWrite $0 "      continue$\n"
    FileWrite $0 "    }$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "    $$executablePath = [string]$$process.ExecutablePath$\n"
    FileWrite $0 "    if ([string]::IsNullOrWhiteSpace($$executablePath)) {$\n"
    FileWrite $0 "      if (([string]$$process.Name).Equals($$ProcessName, [StringComparison]::OrdinalIgnoreCase)) {$\n"
    FileWrite $0 "        $$unknownPathMatches.Add($$process)$\n"
    FileWrite $0 "      }$\n"
    FileWrite $0 "      continue$\n"
    FileWrite $0 "    }$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "    if (Test-PathInsideInstallDirectory -Root $$InstallDir -Candidate $$executablePath) {$\n"
    FileWrite $0 "      $$matches.Add($$process)$\n"
    FileWrite $0 "    }$\n"
    FileWrite $0 "  }$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "  foreach ($$process in $$matches) {$\n"
    FileWrite $0 "    $$path = if ([string]::IsNullOrWhiteSpace([string]$$process.ExecutablePath)) {$\n"
    FileWrite $0 "      '<path unavailable>'$\n"
    FileWrite $0 "    } else {$\n"
    FileWrite $0 "      [string]$$process.ExecutablePath$\n"
    FileWrite $0 "    }$\n"
    FileWrite $0 "    [Console]::Out.WriteLine($\n"
    FileWrite $0 "      $\"Matched protected install process: PID=$$($$process.ProcessId); Name=$$($$process.Name); Path=$$path$\")$\n"
    FileWrite $0 "  }$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "  foreach ($$process in $$unknownPathMatches) {$\n"
    FileWrite $0 "    [Console]::Out.WriteLine($\n"
    FileWrite $0 "      $\"Blocked unknown-path application process: PID=$$($$process.ProcessId); Name=$$($$process.Name); close it manually$\")$\n"
    FileWrite $0 "  }$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "  if ($$matches.Count -eq 0 -and $$unknownPathMatches.Count -eq 0) {$\n"
    FileWrite $0 "    exit 1$\n"
    FileWrite $0 "  }$\n"
    FileWrite $0 "  if ($$Action -eq 'Find') {$\n"
    FileWrite $0 "    exit 0$\n"
    FileWrite $0 "  }$\n"
    FileWrite $0 "$\n"
    FileWrite $0 "  $$force = $$Action -eq 'KillForce'$\n"
    FileWrite $0 "  foreach ($$process in $$matches) {$\n"
    FileWrite $0 "    Stop-Process -Id $$process.ProcessId -Force:$$force -ErrorAction Stop$\n"
    FileWrite $0 "  }$\n"
    FileWrite $0 "  exit 0$\n"
    FileWrite $0 "} catch {$\n"
    FileWrite $0 "  $$message = ([string]$$_.Exception.Message) -replace '[\r\n]+', ' '$\n"
    FileWrite $0 "  [Console]::Out.WriteLine($\"Install process check failed closed: $$message$\")$\n"
    FileWrite $0 "  exit 0$\n"
    FileWrite $0 "}$\n"
    ${If} ${Errors}
      StrCpy ${_WRITE_FAILED} "1"
    ${EndIf}
    FileClose $0
  ${EndIf}
  Pop $0
!macroend

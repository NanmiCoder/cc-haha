<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Embedded into the cu-helper Mach-O via the linker flag
  `-sectcreate __TEXT __info_plist <this file>` (see build.sh). A bare CLI tool
  has no Info.plist by default; TCC needs this metadata to treat cu-helper as a
  stable, distinct subject for Screen Recording (NSScreenCaptureUsageDescription)
  AND to key the grant on a constant bundle id across rebuilds (matches the
  codesign --identifier in build.sh). Without it, disclaiming the responsible
  process flips Accessibility green but Screen Recording is silently denied.
  Do NOT add any App Sandbox keys — under the sandbox AXIsProcessTrusted is
  always false.
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>dev.cchaha.cu-helper</string>
  <key>CFBundleExecutable</key>
  <string>cc-haha-computer-use</string>
  <key>CFBundleName</key>
  <string>cc-haha-computer-use</string>
  <key>CFBundleDisplayName</key>
  <string>cc-haha-computer-use</string>
  <key>CFBundleIconFile</key>
  <string>icon.icns</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSUIElement</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>14.4</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>Claude needs Screen Recording permission to capture the screen so it can perform actions on your computer.</string>
</dict>
</plist>

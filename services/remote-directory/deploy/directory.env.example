# Copy outside the repository to /etc/cc-haha-remote-directory.env (root-owned, mode 0600).
# Replace the placeholder with this computer's actual public SHA-256 host identity.
# Empty, invalid, wildcard, and more than 128 identities are refused at startup.
CC_HAHA_DIRECTORY_ALLOWED_HOST_IDS=REPLACE_WITH_YOUR_64_LOWERCASE_HEX_HOST_ID
CC_HAHA_DIRECTORY_STATE_DIR=/var/lib/cc-haha-remote-directory
CC_HAHA_DIRECTORY_PORT=8788
